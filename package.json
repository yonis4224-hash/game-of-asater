{
  "name": "workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["artifacts/api-server", "artifacts/asateen-game", "lib/*"],
  "scripts": {
    "start": "npm run build:front -s && npm run build:api -s && npm run start:api -s",
    "build:front": "npm -w @workspace/asateen-game run build",
    "build:api": "npm -w @workspace/api-server run build",
    "start:api": "npm -w @workspace/api-server run start",
    "dev:api": "npm -w @workspace/api-server run dev",
    "dev:front": "npm -w @workspace/asateen-game run dev"
  },
  "overrides": {
    "esbuild": "^0.27.3"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
